datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  ADMIN
  USER
}

enum TeamRole {
  TEAM_LEADER
  TEAM_MEMBER
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ReportType {
  PROGRESS
  TASK_COMPLETION
  USAGE
}

enum NotificationType {
  TASK_ASSIGNMENT
  TASK_REMINDER
  MEETING_REMINDER
  DEADLINE_ALERT
  OVERDUE_ALERT
  PROJECT_UPDATE
  ANNOUNCEMENT
}

model User {
  id               Int        @id @default(autoincrement())
  email            String     @unique
  password         String
  profile          String?
  fullName         String
  role             GlobalRole @default(USER)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions           Session[]
  teamMemberships    TeamMember[]
  createdTeams       Team[]               @relation("TeamCreator")
  assignedTasks      TaskAssignee[]
  taskComments       Comment[]
  uploadedFiles      FileAttachment[]
  personalEvents     PersonalEvent[]
  meetingAttendances MeetingParticipant[]
  organizedMeetings  Meeting[]            @relation("MeetingOrganizer")
  reminders          Reminder[]
  notifications      Notification[]
  announcements      Announcement[]

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiry    DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  creatorId   Int
  creator     User     @relation("TeamCreator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        TeamMember[]
  projects       Project[]
  sharedCalendar SharedCalendar?
  meetings       Meeting[]

  @@index([creatorId])
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  teamId   Int
  role     TeamRole @default(TEAM_MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id        Int           @id @default(autoincrement())
  teamId    Int
  title     String
  desc      String
  deadline  DateTime
  status    ProjectStatus @default(ACTIVE)
  progress  Float         @default(0.0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestones      Milestone[]
  tasks           Task[]
  discussionBoard DiscussionBoard?
  reports         Report[]

  @@index([teamId])
  @@index([status])
}

model Milestone {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  dueDate   DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id          Int        @id @default(autoincrement())
  projectId   Int
  title       String
  desc        String
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime
  status      TaskStatus @default(TO_DO)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]
  comments  Comment[]
  files     FileAttachment[]
  reminders Reminder[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model TaskAssignee {
  id         Int      @id @default(autoincrement())
  taskId     Int
  userId     Int
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  authorId  Int
  text      String
  timestamp DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model FileAttachment {
  id         Int      @id @default(autoincrement())
  taskId     Int
  uploaderId Int
  filename   String
  url        String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model PersonalEvent {
  id               Int       @id @default(autoincrement())
  userId           Int
  sharedCalendarId Int?
  title            String
  description      String?
  date             DateTime
  endDate          DateTime?
  recurring        Boolean   @default(false)
  recurrenceRule   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedCalendar SharedCalendar? @relation(fields: [sharedCalendarId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
}

model SharedCalendar {
  id        Int      @id @default(autoincrement())
  teamId    Int      @unique
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  personalEvents PersonalEvent[]
  meetings       Meeting[]

  @@index([teamId])
}

model Meeting {
  id               Int      @id @default(autoincrement())
  teamId           Int
  organizerId      Int
  sharedCalendarId Int?
  title            String
  description      String?
  dateTime         DateTime
  durationMinutes  Int      @default(60)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team           Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizer      User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  sharedCalendar SharedCalendar?      @relation(fields: [sharedCalendarId], references: [id], onDelete: SetNull)
  participants   MeetingParticipant[]
  reminders      Reminder[]

  @@index([teamId])
  @@index([dateTime])
}

model MeetingParticipant {
  id        Int    @id @default(autoincrement())
  meetingId Int
  userId    Int
  status    String @default("INVITED")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  userId      Int
  taskId      Int?
  meetingId   Int?
  triggerTime DateTime
  isTriggered Boolean  @default(false)
  createdAt   DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([triggerTime])
  @@index([isTriggered])
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  reminderId  Int?
  type        NotificationType
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  reminder  Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([read])
}

model DiscussionBoard {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique
  createdAt DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts   Announcement[]

  @@index([projectId])
}

model Announcement {
  id                Int      @id @default(autoincrement())
  discussionBoardId Int
  authorId          Int
  title             String
  text              String
  isPinned          Boolean  @default(false)
  timestamp         DateTime @default(now())

  discussionBoard DiscussionBoard @relation(fields: [discussionBoardId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([discussionBoardId])
}

model Report {
  id        Int        @id @default(autoincrement())
  projectId Int
  type      ReportType
  data      String
  generated DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}
