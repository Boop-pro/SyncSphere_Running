# SyncSphere Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Replace [USER], [PASSWORD], [HOST], [PORT], and [DATABASE] with your PostgreSQL instance credentials
DATABASE_URL="postgresql://postgres:shinchan@localhost:5432/syncsphere?schema=public"

# Session Security Key (Replace with a random 64-character secret)
SESSION_SECRET="22243eae4198b5a08b01079d9942f36c0e8ea81fb70490e7e885716a94dedee5"

# Password Reset Email Service (Nodemailer SMTP settings)
# For local development, Mailtrap or Ethereal can be used
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="no-reply@syncsphere.local"
